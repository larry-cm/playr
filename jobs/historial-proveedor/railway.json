{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "jobs/historial-proveedor/Dockerfile",
    "watchPatterns": ["app/lib/**", "jobs/historial-proveedor/**", "tsconfig.json"]
  },
  "deploy": {
    "cronSchedule": "0 5 * * *",
    "restartPolicyType": "NEVER"
  }
}
